        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "import ast\n\nYASAK_IMPORTLAR = {\"subprocess\", \"socket\", \"ctypes\"}\nRISKLI_CAGRILAR = {\"eval\", \"exec\", \"compile\", \"__import__\"}\n\n\ndef cagri_adi(node):\n    if isinstance(node, ast.Name):\n        return node.id\n    if isinstance(node, ast.Attribute):\n        sol = cagri_adi(node.value)\n        return f\"{sol}.{node.attr}\" if sol else node.attr\n    return \"\"\n\n\ndef guvenlik_raporu(kaynak):\n    yasak_importlar = set()\n    riskli_cagrilar = set()\n    agac = ast.parse(kaynak)\n\n    # ast.walk ile import ve çağrı düğümlerini incele.\n    pass\n\n\nif __name__ == \"__main__\":\n    print(guvenlik_raporu(\"import subprocess as sp\\nsp.run(['echo', 'x'])\\neval('1+1')\"))\n"
