      "id": "expert.parallelism.queue-workers",
      "moduleId": "parallelism-systems",
      "order": 5,
      "title": "Queue ile üretici-tüketici işçileri kur",
      "summary": "Queue görev aktarımını thread-safe yapar; sentinel, task_done ve join birlikte temiz kapanış sağlar.",
      "levelLabel": "Expert Systems",
      "mode": "code-completion",
      "task": {
        "title": "Görev kuyruğundaki sayıları worker thread'lerinde işle",
        "instructions": [
          "Worker thread'lerini başlat.",
          "Değerleri ve her worker için bir sentinel değeri kuyruğa koy.",
          "Her get çağrısını task_done ile eşleştir.",
          "Queue ve thread join çağrılarıyla temiz kapanış yap."
        ],
        "requirements": [
          "queue.Queue kullanılmalı.",
          "Sonuç listesi Lock ile korunmalı.",
          "Arka planda çalışan thread bırakılmamalı."
        ],
        "sampleOutput": "[1, 4, 9, 16]",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev dışarıdan girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "from queue import Queue\nfrom threading import Lock, Thread\n\n\ndef kuyruk_isle(degerler, worker_sayisi=3):\n    if not degerler:\n        return []\n\n    gorevler = Queue()\n    sonuclar = []\n    kilit = Lock()\n    sentinel = object()\n\n    def worker():\n        while True:\n            deger = gorevler.get()\n            try:\n                if deger is sentinel:\n                    return\n                sonuc = deger * deger\n                with kilit:\n                    sonuclar.append(sonuc)\n            finally:\n                gorevler.task_done()\n\n    # Thread'leri başlat, görevleri/sentinel'ları ekle ve temiz kapat.\n    pass\n\n    return sorted(sonuclar)\n\n\nif __name__ == \"__main__\":\n    print(kuyruk_isle([1, 2, 3, 4], 2))\n"
      },
