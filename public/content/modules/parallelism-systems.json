        "stdinPlaceholder": "Bu görev dışarıdan girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "from concurrent.futures import ThreadPoolExecutor\nfrom threading import Lock\nimport time\n\n\ndef guvenli_sayac(is_parca, tekrar):\n    if is_parca <= 0 or tekrar <= 0:\n        return 0\n\n    sayac = [0]\n    kilit = Lock()\n\n    def arttir(_):\n        for _ in range(tekrar):\n            mevcut = sayac[0]\n            time.sleep(0)\n            sayac[0] = mevcut + 1\n\n    with ThreadPoolExecutor(max_workers=min(8, is_parca)) as executor:\n        list(executor.map(arttir, range(is_parca)))\n\n    return sayac[0]\n\n\nif __name__ == \"__main__\":\n    print(guvenli_sayac(4, 100))\n"
      },
