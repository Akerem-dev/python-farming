    {
      "id": "expert.parallelism.as-completed",
      "moduleId": "parallelism-systems",
      "order": 3,
      "title": "as_completed ile sonuçları ve hataları ayır",
      "summary": "Future'lar tamamlanma sırasıyla toplanabilir; her işin hatası diğer görevlerin sonucunu kaybettirmemelidir.",
      "levelLabel": "Expert Systems",
      "mode": "code",
      "task": {
        "title": "Bağımsız bölme görevlerini güvenli biçimde tamamla",
        "instructions": [
          "Her görevi executor.submit ile havuza gönder.",
          "Future'ları as_completed ile tüket.",
          "ZeroDivisionError alan görevi hata kaydı olarak sakla.",
          "Sonuçları görev kimliğine göre sırala."
        ],
        "requirements": [
          "Bir görevin hatası bütün havuzu durdurmamalı.",
          "submit ve as_completed birlikte kullanılmalı.",
          "Dönüş listesi deterministik olmalı."
        ],
        "sampleOutput": "[{\"id\": \"a\", \"sonuc\": 5.0}, {\"hata\": \"sifira_bolme\", \"id\": \"b\"}]",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev dışarıdan girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "from concurrent.futures import ThreadPoolExecutor, as_completed\n\n\ndef bol(gorev):\n    gorev_id, pay, bolen = gorev\n    return {\"id\": gorev_id, \"sonuc\": pay / bolen}\n\n\ndef gorevleri_tamamla(gorevler):\n    if not gorevler:\n        return []\n\n    kayitlar = []\n    with ThreadPoolExecutor(max_workers=min(4, len(gorevler))) as executor:\n        future_to_id = {\n            executor.submit(bol, gorev): gorev[0]\n            for gorev in gorevler\n        }\n        # Future sonuçlarını tamamlandıkça topla ve hataları ayır.\n        pass\n\n    return sorted(kayitlar, key=lambda kayit: kayit[\"id\"])\n\n\nif __name__ == \"__main__\":\n    print(gorevleri_tamamla([[\"a\", 10, 2], [\"b\", 4, 0]]))\n"
      },
      "hints": [
        {
          "title": "Future kimliği",
          "body": "future_to_id sözlüğü hata anında hangi görevin tamamlandığını söyler."
        },
        {
          "title": "Hata izolasyonu",
          "body": "future.result() çağrısını try/except ZeroDivisionError içinde çalıştır."
        }
      ],
