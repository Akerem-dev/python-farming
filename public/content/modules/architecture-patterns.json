      "levelLabel": "Advanced Learning",
      "mode": "code",
      "task": {
        "title": "Dependency injection ile bağımlılığı dışarıdan al",
        "instructions": [
          "SiparisServisi içindeki doğrudan Bildirimci oluşturma işlemini kaldır.",
          "Bildirimci bağımlılığını __init__ üzerinden dışarıdan al.",
          "Sahte bildirimciyle çalışan gizli senaryoları geçir."
        ],
        "requirements": [
          "SiparisServisi(bildirimci) biçiminde kurulmalı.",
          "tamamla() yalnız enjekte edilen gonder() metodunu kullanmalı.",
          "Sabit çıktı üretilmemeli."
        ],
        "sampleOutput": "Görev çıktısı",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "class Bildirimci:\n    def gonder(self, mesaj):\n        return f\"Gönderildi: {mesaj}\"\n\n\nclass SiparisServisi:\n    def __init__(self):\n        self.bildirimci = Bildirimci()\n\n    def tamamla(self, siparis_id):\n        mesaj = f\"Sipariş {siparis_id} tamamlandı\"\n        return self.bildirimci.gonder(mesaj)\n\n\ndef bildirim_senaryosu(siparis_id):\n    class SahteBildirimci:\n        def __init__(self):\n            self.mesajlar = []\n\n        def gonder(self, mesaj):\n            self.mesajlar.append(mesaj)\n            return f\"TEST:{mesaj}\"\n\n    sahte = SahteBildirimci()\n    servis = SiparisServisi(sahte)\n    sonuc = servis.tamamla(siparis_id)\n    return {\"sonuc\": sonuc, \"mesajlar\": sahte.mesajlar}\n"
      },
      "hints": [],
      "validation": {
