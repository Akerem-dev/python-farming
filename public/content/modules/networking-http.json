      "id": "advanced.http.retry-timeout",
      "moduleId": "networking-http",
      "order": 5,
      "title": "Timeout ve retry politikası kur",
      "summary": "Gerçek ağ yerine sahte transport kullanarak timeout, deneme sınırı ve üstel geri çekilme davranışını geliştir.",
      "levelLabel": "Advanced Learning",
      "mode": "code",
      "task": {
        "title": "Geçici timeout sonrasında isteği yeniden dene",
        "instructions": [
          "guvenli_get(senaryo, url, max_deneme=3) fonksiyonunu tamamla.",
          "FakeTransport.get() çağrısını try/except TimeoutError içinde çalıştır.",
          "Başarılı yanıtta JSON verisini, deneme sayısını ve bekleme planını döndür."
        ],
        "requirements": [
          "En fazla max_deneme kadar istek yapılmalı.",
          "Timeout sonrası 0.1, 0.2, 0.4 biçiminde geri çekilme hesaplanmalı.",
          "Başarısızlıkta ok=False sonucu dönmeli.",
          "Kaynak transport.py değiştirilmemeli."
        ],
        "sampleOutput": "{\"ok\": true, \"veri\": {\"ad\": \"Defter\"}, \"deneme\": 2, \"beklemeler\": [0.1]}",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "",
        "entrypoint": "main.py",
        "files": [
          {
            "path": "main.py",
            "starterCode": "from retry_client import guvenli_get\n\n\nif __name__ == \"__main__\":\n    senaryo = [\n        {\"kind\": \"timeout\"},\n        {\"status\": 200, \"body\": '{\"ad\": \"Defter\"}'},\n    ]\n    print(guvenli_get(senaryo, \"https://api.local/urunler/1\"))\n"
          },
          {
            "path": "retry_client.py",
            "starterCode": "import json\nfrom transport import FakeTransport\n\n\ndef guvenli_get(senaryo, url, max_deneme=3):\n    # Timeout sonrasında 0.1, 0.2... geri çekilme planı üret.\n    pass\n"
          },
          {
            "path": "transport.py",
            "starterCode": "class FakeTransport:\n    def __init__(self, senaryo):\n        self._senaryo = list(senaryo)\n        self.calls = []\n\n    def get(self, url, timeout=2, headers=None):\n        self.calls.append({\n            \"url\": url,\n            \"timeout\": timeout,\n            \"headers\": dict(headers or {}),\n        })\n        if not self._senaryo:\n            raise RuntimeError(\"Sahte transport yanıtı kalmadı.\")\n\n        sonuc = self._senaryo.pop(0)\n        if sonuc.get(\"kind\") == \"timeout\":\n            raise TimeoutError(\"İstek zaman aşımına uğradı.\")\n\n        return {\n            \"status\": int(sonuc.get(\"status\", 200)),\n            \"headers\": dict(sonuc.get(\"headers\", {})),\n            \"body\": sonuc.get(\"body\", \"{}\"),\n        }\n",
            "readOnly": true
          }
        ]
      },
      "hints": [
        {
          "title": "Deneme sayısı",
          "body": "range(max_deneme) ile her denemede transport.get çağır."
        },
        {
          "title": "Geri çekilme",
          "body": "Timeout sonrası son deneme değilse round(0.1 * (2 ** deneme), 2) değerini listeye ekle."
        }
      ],
