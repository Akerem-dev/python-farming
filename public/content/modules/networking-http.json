      "id": "advanced.http.error-debugging",
      "moduleId": "networking-http",
      "order": 4,
      "title": "Hata Avcısı: HTTP hatasını yutma",
      "summary": "HTTPError ayrıntılarını kaybetmeden uygulama alanına uygun ApiHatasi üret.",
      "levelLabel": "Advanced Learning",
      "mode": "debugging",
      "task": {
        "title": "404 gövdesini anlamlı hataya dönüştür",
        "instructions": [
          "Programı çalıştır ve çıplak except nedeniyle kaybolan hata bilgisini incele.",
          "Yalnız HTTPError yakala; status kodunu ve JSON mesajını oku.",
          "ApiHatasi içinde kod ve mesajı koruyarak yeniden raise et."
        ],
        "requirements": [
          "Çıplak except kullanılmamalı.",
          "HTTPError açıkça yakalanmalı.",
          "ApiHatasi, Exception tabanından türemeli.",
          "404 mesajı kullanıcıya taşınmalı."
        ],
        "sampleOutput": "ApiHatasi: 404 - ürün bulunamadı",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "import json\nfrom io import BytesIO\nfrom urllib.error import HTTPError\n\n\nclass ApiHatasi(Exception):\n    pass\n\n\ndef yanit_coz(kod, govde):\n    try:\n        if kod >= 400:\n            raise HTTPError(\n                \"https://api.local/urunler/99\",\n                kod,\n                \"HTTP error\",\n                {},\n                BytesIO(govde.encode(\"utf-8\")),\n            )\n        return json.loads(govde)\n    except:\n        return {}\n\n\nif __name__ == \"__main__\":\n    try:\n        yanit_coz(404, '{\"mesaj\": \"ürün bulunamadı\"}')\n    except ApiHatasi as hata:\n        print(f\"ApiHatasi: {hata}\")\n"
      },
      "hints": [
        {
          "title": "HTTPError gövdesi",
          "body": "HTTPError nesnesinin read() metodu response body bytes değerini verir."
        },
        {
          "title": "Mesajı koru",
          "body": "json.loads(hata.read().decode('utf-8')) ile mesajı alıp ApiHatasi(f'{hata.code} - {mesaj}') raise et."
        }
      ],
