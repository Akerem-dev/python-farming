      "editor": {
        "filename": "main.py",
        "starterCode": "def ortak_kodlar(sol, sag):\n    sonuc = []\n    for kod in sol:\n        for diger in sag:\n            if kod == diger and kod not in sonuc:\n                sonuc.append(kod)\n    return sorted(sonuc)\n\n\nif __name__ == \"__main__\":\n    print(ortak_kodlar([\"A\", \"B\", \"A\"], [\"B\", \"C\", \"A\"]))\n"
      },
      "hints": [
        {
          "title": "Hızlı üyelik",
          "body": "sag_kodlari = set(sag) oluşturup tek döngüde kod in sag_kodlari kontrolü yap."
        }
      ],
