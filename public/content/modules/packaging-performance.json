      "id": "advanced.performance.cache-prediction",
      "moduleId": "packaging-performance",
      "order": 2,
      "title": "Önbellekli çağrı sayısını tahmin et",
      "summary": "lru_cache aynı argümanla tekrar çağrılan fonksiyonun gövdesini yeniden çalıştırmaz.",
      "levelLabel": "Advanced Performance",
      "mode": "output-prediction",
      "task": {
        "title": "Önbellekli çağrı sayısını tahmin et",
        "instructions": [
          "fibonacci(6) sonucunu belirle.",
          "İlk çağrıdan sonra kaç farklı n değeri hesaplandığını say.",
          "İkinci aynı çağrının sayacı değiştirip değiştirmediğini belirle."
        ],
        "requirements": [
          "Dört çıktı satırı birlikte seçilmeli.",
          "Önbellek anahtarı fonksiyon argümanıdır."
        ],
        "sampleOutput": "8 / 7 / 8 / 7",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev dışarıdan girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "from functools import lru_cache\n\n\nsayac = {\"hesap\": 0}\n\n\n@lru_cache(maxsize=None)\ndef fibonacci(n):\n    sayac[\"hesap\"] += 1\n    if n < 2:\n        return n\n    return fibonacci(n - 1) + fibonacci(n - 2)\n\n\nprint(fibonacci(6))\nprint(sayac[\"hesap\"])\nprint(fibonacci(6))\nprint(sayac[\"hesap\"])\n"
      },
      "hints": [],
      "validation": {
        "id": "advanced.performance.cache-prediction",
