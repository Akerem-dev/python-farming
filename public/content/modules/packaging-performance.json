    {
      "id": "advanced.performance.tracemalloc",
      "moduleId": "packaging-performance",
      "order": 5,
      "title": "tracemalloc ile bellek farkını gözlemle",
      "summary": "İki snapshot arasındaki tahsis farkını ölçerken ara liste üretmeden hesap yap.",
      "levelLabel": "Advanced Performance",
      "mode": "code",
      "task": {
        "title": "tracemalloc ile bellek farkını gözlemle",
        "instructions": [
          "toplam değerini karelerin toplamı olarak hesapla.",
          "Generator expression kullan.",
          "Snapshot karşılaştırmasını ve stop çağrısını koru."
        ],
        "requirements": [
          "En az iki snapshot alınmalı.",
          "Ara liste yerine GeneratorExp kullanılmalı.",
          "Boş veri çalışmalı."
        ],
        "sampleOutput": "{\"adet\": 3, \"toplam\": 14, \"olcum_yapildi\": true}",
        "stdinEnabled": false,
        "stdinPlaceholder": "Bu görev dışarıdan girdi istemiyor.",
        "defaultStdin": ""
      },
      "editor": {
        "filename": "main.py",
        "starterCode": "import tracemalloc\n\n\ndef bellek_ozeti(degerler):\n    tracemalloc.start()\n    once = tracemalloc.take_snapshot()\n    # Ara liste yerine generator expression kullanarak toplamı hesapla.\n    toplam = 0\n    sonra = tracemalloc.take_snapshot()\n    fark = sum(stat.size_diff for stat in sonra.compare_to(once, \"lineno\"))\n    tracemalloc.stop()\n    return {\n        \"adet\": len(degerler),\n        \"toplam\": toplam,\n        \"olcum_yapildi\": isinstance(fark, int),\n    }\n\n\nif __name__ == \"__main__\":\n    print(bellek_ozeti([1, 2, 3]))\n"
      },
      "hints": [
        {
          "title": "Lazy toplam",
          "body": "sum(deger * deger for deger in degerler) ara liste oluşturmaz."
        }
      ],
      "validation": {
