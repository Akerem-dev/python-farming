        "starterCode": "import cProfile\nimport io\nimport pstats\n\n\ndef is_yuku(veriler):\n    return sum(deger * deger for deger in veriler)\n\n\ndef profil_ozeti(veriler):\n    profiler = cProfile.Profile()\n    # Profili başlat, is_yuku fonksiyonunu çalıştır ve durdur.\n    # pstats.Stats ile toplam çağrı sayısını ve is_yuku görünürlüğünü döndür.\n    pass\n\n\nif __name__ == \"__main__\":\n    print(profil_ozeti([1, 2, 3, 4]))\n"
